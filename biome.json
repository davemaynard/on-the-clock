{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["web/**", "package.json", "biome.json", "!on_the_clock/assets"] },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "javascript": {
    "formatter": { "quoteStyle": "double", "trailingCommas": "all" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "noDescendingSpecificity": "off" }
    }
  }
}
